# 复制为 .env 后填写（.env 已被 gitignore，密钥不入库）
# 两种供应方式二选一：

# 方式 A：OpenAI 直连
OPENAI_API_KEY=sk-...

# 方式 B：OpenRouter（OpenAI 兼容；联网搜索走其 web 插件）
# OPENROUTER_API_KEY=sk-or-...
# 只设一个 key 时自动选择对应 provider；两个都设时默认 OpenAI，可显式指定：
# FINANCE_AGENT_PROVIDER=openrouter

# 可选：覆盖默认模型（OpenAI 直连默认 gpt-5.5；OpenRouter 默认 openai/gpt-5.5，
# 也可换其他模型，如 anthropic/claude-sonnet-5）
# FINANCE_AGENT_MODEL=openai/gpt-5.5

# 可选：OpenRouter 联网搜索（web 插件）设置
# FINANCE_AGENT_SEARCH_MODEL=openai/gpt-5-mini   # 检索用模型（默认同主模型，换小模型省钱）
# FINANCE_AGENT_WEB_MAX_RESULTS=5                # 每次检索返回的网页条数

# 可选：单次调用输出 token 上限（控成本；OpenRouter 低额度 key 预算预检也按此计算）
# FINANCE_AGENT_MAX_TOKENS=12000

# 可选：自建 OpenAI 兼容网关
# FINANCE_AGENT_BASE_URL=https://your-gateway/v1

# 可选：mock 模式（=1 时行情用内置种子、资讯用离线夹具，不访问外部数据 API）
# FINANCE_AGENT_MOCK=1
