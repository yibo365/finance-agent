# 复制为 .env 后填写（.env 已被 gitignore，密钥不入库）。
# 也可以不改此文件：启动 Web 界面后在左下角"设置"中填写，会自动写回 .env。

# LLM：任何 OpenAI 兼容供应方（三元组 base_url + key + model）
OPENAI_API_KEY=
# Base URL 留空 = OpenAI 官方；OpenRouter / 自建网关填对应地址：
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# FINANCE_AGENT_MODEL=anthropic/claude-haiku-4.5
#（兼容旧配置：只设 OPENROUTER_API_KEY 时自动采用其 key 与 base_url）

# 联网搜索：Tavily（https://tavily.com 注册，免费额度约 1000 次/月）
# 确定性搜索 API，结构化结果不经 LLM 转述——换 LLM 供应方不改变检索数据。
# 未配置时联网搜索不可用（事件研究退回 HN/Yahoo 两路并如实声明）。
# TAVILY_API_KEY=
# FINANCE_AGENT_WEB_MAX_RESULTS=5                # 每次检索返回的结果条数

# 可选：单次调用输出 token 上限（控成本；部分网关按此做预算预检）
# FINANCE_AGENT_MAX_TOKENS=12000

# 可选：mock 模式（=1 时行情用内置种子、资讯用离线夹具，不访问外部数据 API）
# FINANCE_AGENT_MOCK=1

# 可选：单次 subagent 运行的检索次数预算（确定性收敛闸，防止无限检索）
# FINANCE_AGENT_SEARCH_BUDGET=36

# 可选：结构化输出的 response_format 策略（仅网关路径）
# object（默认，Kimi/DeepSeek 等只支持 json_object）| schema（OpenRouter 等支持
# json_schema 时更严格）| off（不发送 response_format）
# FINANCE_AGENT_JSON_MODE=object
